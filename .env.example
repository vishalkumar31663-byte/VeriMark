# VeriMark Environment Configuration
# Copy to .env for local development. Never commit real secrets or private keys.

NODE_ENV="development"
PORT="3000"

# Application public URL (used for QR code verification URLs on PDF marksheets)
APP_URL="http://localhost:3000"

# HMAC secret for signing session JWTs (generate a 32+ byte random string in production)
JWT_SECRET="replace-with-secure-random-64-char-hex-secret"

# Storage paths (external trust directory MUST be kept separate from SQLite database)
VERIMARK_DATA_DIR="./data/db"
VERIMARK_TRUST_DIR="./data/trust"

# Set to "true" ONLY in development/hackathon demo environments. Automatically disabled in production.
VERIMARK_ENABLE_TAMPER_LAB="true"
